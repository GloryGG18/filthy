# --- основне ---
PORT=3000
# Публічна https-адреса застосунку (Telegram відкриває Mini App лише по https)
PUBLIC_URL=https://tickets.example.sk
DATA_DIR=./data
BOT_TOKEN=123456:ABC-from-BotFather
# Telegram ID адмінів через кому (свій ID можна дізнатися командою /id у боті)
ADMIN_IDS=111111111
# Чат, куди падають скріншоти репостів з кнопками «Схвалити/Відхилити» (група адмінів або особистий чат)
ADMIN_CHAT_ID=
# Довгий випадковий рядок; не змінювати після запуску, інакше видані QR перестануть працювати
QR_SECRET=change-me-to-a-long-random-string
# Тільки для локальної перевірки в браузері: /?dev=111111111
DEV_AUTH=0

# --- ціни за замовчуванням для нових подій, € ---
PRICE_DOOR=12
PRICE_ONLINE=10
PRICE_REPOST=8
RESERVATION_MINUTES=30
INSTAGRAM_HANDLE=@filthy.sk
MIN_FOLLOWERS=100

# --- PAY by square (рахунок, на який платять гості) ---
PBS_IBAN=SK00 0000 0000 0000 0000 0000
PBS_BIC=TATRSKBX
PBS_BENEFICIARY=Filthy s.r.o.

# --- автопідтвердження переказів з виписки: tatra | fio | none ---
BANK_PROVIDER=none
BANK_POLL_SECONDS=30
FIO_TOKEN=
TATRA_CLIENT_ID=
TATRA_CLIENT_SECRET=
TATRA_ACCOUNT_ID=

# --- monobank (банка для українських карток) ---
# Токен з https://api.monobank.ua/ (власника банки)
MONO_TOKEN=
# ID банки з /personal/client-info (поле jars[].id)
MONO_JAR_ID=
# Посилання на банку, яке бачить гість
MONO_JAR_URL=https://send.monobank.ua/jar/XXXXXXXX
MONO_WEBHOOK_SECRET=change-me
MONO_TOLERANCE=0.98
MONO_FALLBACK_RATE=48

REMINDER_HOUR=12
TZ=Europe/Bratislava
